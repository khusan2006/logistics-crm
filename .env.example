SECRET_KEY=change-me
DEBUG=True
# Comma-separated. In production set DEBUG=False and list your real host(s).
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed in production behind HTTPS, e.g. https://crm.example.com
CSRF_TRUSTED_ORIGINS=
# Read by BOTH Django (config/settings.py) and docker-compose.yml, so the app and
# the container it talks to cannot end up disagreeing. Compose loads this file by
# itself; POSTGRES_PASSWORD has no default there and must be set.
POSTGRES_DB=granulalog
POSTGRES_USER=granulalog
POSTGRES_PASSWORD=granulalog_dev_password
POSTGRES_HOST=127.0.0.1
# The HOST port. 5434 rather than 5432 because other projects on one machine
# tend to hold the standard one; inside the container it is 5432 either way.
POSTGRES_PORT=5434
# Password for the 'otabek' owner account, set ONLY when the seed commands first
# create it (a redeploy never resets a password that has since been changed).
# Leave blank and the command generates a random one and prints it once.
SEED_OWNER_PASSWORD=
# Optional: overdue-loads Telegram digest (python manage.py send_telegram_digest).
# Leave both blank to disable — the command then prints a notice and exits
# without any network call.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
